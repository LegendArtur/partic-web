# Build stage
FROM node:22-bullseye AS builder
WORKDIR /app

# Install pnpm and tsx (to run typescript scripts)
RUN npm install -g pnpm tsx

# Enable tsx for node executions and skip pnpm-link in docker
ENV NODE_OPTIONS="--import tsx"
ENV PLAYWRIGHT_COMMON_DOCKER=1

# Copy dependency files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY patches/ ./patches/
COPY scripts/ ./scripts/

# Remove postinstall script as it requires ts-node and is dev-only
RUN npm pkg delete scripts.postinstall

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code (excluding dockerignored files)
COPY . .

# Setup config
RUN cp config.sample.json config.json

# Build the application
# We set a fixed version to avoid git-based versioning scripts failing
ENV VERSION=coolify-deploy
RUN pnpm build

# Serve stage
FROM nginxinc/nginx-unprivileged:alpine-slim
COPY --from=builder /app/webapp /usr/share/nginx/html
COPY docker/nginx-templates/* /etc/nginx/templates/
COPY docker/docker-entrypoint.d/* /docker-entrypoint.d/

# Expose port 80 (Coolify container port)
EXPOSE 80

# Healthcheck
HEALTHCHECK --start-period=5s CMD wget -q --spider http://localhost:80/config.json || exit 1

CMD ["nginx", "-g", "daemon off;"]
